# Variables de entorno — ProAhorro
# Copiar este archivo como .env y completar con tus credenciales reales

# ──────────────────────────────────────────
# SUPABASE
# ──────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# ──────────────────────────────────────────
# APP ENVIRONMENT
# ──────────────────────────────────────────
APP_ENV=development

# ──────────────────────────────────────────
# EAS / APP STORE (solo para build/submit)
# ──────────────────────────────────────────
# APPLE_ID=tu@email.com
# APPLE_TEAM_ID=TU_TEAM_ID
# ASC_APP_ID=TU_APP_STORE_CONNECT_APP_ID

# ──────────────────────────────────────────
# GITHUB ACTIONS (para CI/CD y keepalive)
# Configurar en Settings → Secrets del repositorio
# ──────────────────────────────────────────
# SUPABASE_URL=https://TU_PROYECTO.supabase.co
# SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI
